    affiliation: "Istituto Nazionale di Geofisica e Vulcanologia (INGV)"
repository-code: "https://github.com/INGV/mcp-fdsnws-station"
url: "https://github.com/INGV/mcp-fdsnws-station"
license: AGPL-3.0-or-later
keywords:
  - model context protocol
  - mcp
  - fdsnws
  - station metadata
  - stationxml
  - seismology
  - obspy
